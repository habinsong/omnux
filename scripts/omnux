#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local source_path="$1"
  while [ -L "$source_path" ]; do
    local source_dir
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    local linked_path
    linked_path="$(readlink "$source_path")"
    if [[ "$linked_path" != /* ]]; then
      source_path="$source_dir/$linked_path"
    else
      source_path="$linked_path"
    fi
  done

  local final_dir
  final_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  printf '%s/%s\n' "$final_dir" "$(basename "$source_path")"
}

SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]:-$0}")"
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"

resolve_cli_state_dir() {
  printf '%s/cli\n' "${HOME}/.omnux"
}

STATE_DIR="$(resolve_cli_state_dir)"
PID_FILE="${STATE_DIR}/middleware.pid"
LOG_FILE="${STATE_DIR}/middleware.log"
META_FILE="${STATE_DIR}/last-start.env"
SETUP_MARKER_FILE="${STATE_DIR}/setup-complete"
MIDDLEWARE_PROJECT="${REPO_ROOT}/apps/omnux-middleware/Omnux.Middleware.csproj"
PACKAGE_LOCK="${REPO_ROOT}/package-lock.json"
DEFAULT_PORT="${OMNUX_WS_PORT:-41880}"
DEFAULT_BASE_URL="http://127.0.0.1:${DEFAULT_PORT}"

usage() {
  cat <<'EOF'
사용법:
  omnux           Tauri 데스크톱 앱 + 미들웨어 dev 실행 (포그라운드, Ctrl+C 종료)
  omnux desktop   위와 동일
  omnux start     미들웨어만 백그라운드 실행 (레거시 대시보드 http://127.0.0.1:41880/)
  omnux stop      미들웨어 서버 종료 (= shutdown)
  omnux shutdown  미들웨어 서버 종료
  omnux status    미들웨어 실행 상태 확인
  omnux setup     의존성 설치, 빌드, 검증, 명령 등록
EOF
}

info() {
  printf '[omnux] %s\n' "$1"
}

fail() {
  printf '[omnux] %s\n' "$1" >&2
  exit 1
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

current_port() {
  printf '%s\n' "${OMNUX_WS_PORT:-41880}"
}

current_base_url() {
  printf 'http://127.0.0.1:%s\n' "$(current_port)"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

read_pid_file() {
  if [ -f "$PID_FILE" ]; then
    tr -d '[:space:]' < "$PID_FILE"
  fi
}

is_pid_alive() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1
}

server_health_ok() {
  curl -fsS "$(current_base_url)/healthz" >/dev/null 2>&1
}

server_ready_ok() {
  curl -fsS "$(current_base_url)/readyz" >/dev/null 2>&1
}

normalize_runtime_env() {
  local port
  port="$(current_port)"
  export OMNUX_WS_PORT="${OMNUX_WS_PORT:-$port}"
  # CLI/desktop 보조 서버는 실제 봇 polling 소유권을 뺏지 않는다. 발송은 그대로 동작한다.
  export OMNUX_TELEGRAM_POLLING_DISABLED="${OMNUX_TELEGRAM_POLLING_DISABLED:-1}"
}

cleanup_stale_state() {
  local pid
  pid="$(read_pid_file || true)"
  if [ -n "$pid" ] && ! is_pid_alive "$pid"; then
    rm -f "$PID_FILE"
  fi
}

middleware_pids() {
  if ! command_exists pgrep; then
    return 0
  fi

  pgrep -f "$MIDDLEWARE_PROJECT" || true
}

attach_to_existing_server_if_possible() {
  if ! server_health_ok; then
    return 1
  fi

  local pids
  pids="$(middleware_pids)"
  if [ -z "$pids" ]; then
    return 1
  fi

  local adopted_pid
  adopted_pid="$(printf '%s\n' "$pids" | tail -n 1)"
  if [ -z "$adopted_pid" ]; then
    return 1
  fi

  ensure_state_dir
  printf '%s\n' "$adopted_pid" > "$PID_FILE"
  info "이미 실행 중인 서버를 재사용합니다. pid=${adopted_pid} url=$(current_base_url)/"
  return 0
}

ensure_runtime_commands() {
  local missing=()
  local required=(dotnet python3 node npm make cc curl)
  local tool
  for tool in "${required[@]}"; do
    if ! command_exists "$tool"; then
      missing+=("$tool")
    fi
  done

  if [ "${#missing[@]}" -gt 0 ]; then
    fail "필수 도구가 없습니다: ${missing[*]}. 먼저 'omnux setup'을 실행하세요."
  fi
}

has_node_modules() {
  [ -d "${REPO_ROOT}/node_modules" ]
}

is_setup_complete() {
  [ -f "$SETUP_MARKER_FILE" ] || return 1
  has_node_modules || return 1
  return 0
}

write_setup_marker() {
  ensure_state_dir
  cat > "$SETUP_MARKER_FILE" <<EOF
repo=$REPO_ROOT
script=$SCRIPT_PATH
completed_at=$(date '+%Y-%m-%d %H:%M:%S %z')
EOF
}

ensure_setup_if_needed() {
  if is_setup_complete; then
    return 0
  fi

  info "첫 실행이거나 setup 상태가 없어 자동 setup을 시작합니다."
  run_setup
}

port_in_use_by_other_process() {
  local port
  port="$(current_port)"
  if ! command_exists lsof; then
    return 1
  fi

  local lsof_output
  lsof_output="$(lsof -iTCP:"$port" -sTCP:LISTEN -n -P 2>/dev/null || true)"
  [ -n "$lsof_output" ]
}

wait_for_ready() {
  local pid="$1"
  local attempts="${OMNUX_CLI_READY_TIMEOUT_SEC:-180}"
  local step=0

  if ! [[ "$attempts" =~ ^[0-9]+$ ]] || [ "$attempts" -le 0 ]; then
    attempts=180
  fi

  while [ "$step" -lt "$attempts" ]; do
    if ! is_pid_alive "$pid"; then
      printf '\n' >&2
      tail -n 40 "$LOG_FILE" >&2 || true
      fail "서버 프로세스가 준비 전에 종료됐습니다. 로그를 확인하세요: $LOG_FILE"
    fi

    if server_health_ok && server_ready_ok; then
      return 0
    fi

    sleep 1
    step=$((step + 1))
  done

  printf '\n' >&2
  tail -n 40 "$LOG_FILE" >&2 || true
  fail "서버가 ${attempts}초 안에 $(current_base_url) 에서 준비 상태가 되지 않았습니다. 로그: $LOG_FILE"
}

write_start_metadata() {
  local pid="$1"
  cat > "$META_FILE" <<EOF
pid=$pid
port=$(current_port)
url=$(current_base_url)/
repo=$REPO_ROOT
log=$LOG_FILE
started_at=$(date '+%Y-%m-%d %H:%M:%S %z')
EOF
}

start_server() {
  ensure_state_dir
  cleanup_stale_state
  ensure_setup_if_needed
  ensure_runtime_commands
  normalize_runtime_env

  local current_pid
  current_pid="$(read_pid_file || true)"
  if is_pid_alive "$current_pid"; then
    if server_health_ok; then
      info "이미 실행 중입니다. pid=${current_pid} url=$(current_base_url)/"
      return 0
    fi
  fi

  if attach_to_existing_server_if_possible; then
    return 0
  fi

  if port_in_use_by_other_process; then
    fail "포트 $(current_port) 가 이미 사용 중입니다. 기존 서버를 정리한 뒤 다시 시도하세요."
  fi

  {
    printf '\n[%s] omnux start\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"
  } >> "$LOG_FILE"

  local pid
  pid="$(
    python3 - "$REPO_ROOT" "$MIDDLEWARE_PROJECT" "$LOG_FILE" <<'PY'
import os
import subprocess
import sys

repo_root, project_path, log_path = sys.argv[1:4]
env = os.environ.copy()
port = env.get("OMNUX_WS_PORT") or "41880"
env.setdefault("OMNUX_WS_PORT", port)
env.setdefault("OMNUX_TELEGRAM_POLLING_DISABLED", "1")
workspace_root = env.get("OMNUX_WORKSPACE_ROOT") or os.path.join(repo_root, "workspace", "coding")
env.setdefault("OMNUX_WORKSPACE_ROOT", workspace_root)
local_otp = env.get("OMNUX_ENABLE_LOCAL_OTP_FALLBACK") or "1"
env.setdefault("OMNUX_ENABLE_LOCAL_OTP_FALLBACK", local_otp)
startup_probe = env.get("OMNUX_GATEWAY_STARTUP_PROBE") or "1"
env.setdefault("OMNUX_GATEWAY_STARTUP_PROBE", startup_probe)

with open(log_path, "ab", buffering=0) as log_file:
    process = subprocess.Popen(
        ["dotnet", "run", "--project", project_path],
        cwd=repo_root,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=log_file,
        stderr=log_file,
        start_new_session=True
    )

print(process.pid)
PY
  )"
  printf '%s\n' "$pid" > "$PID_FILE"
  write_start_metadata "$pid"

  info "서버 시작 중입니다. pid=${pid}"
  wait_for_ready "$pid"

  info "서버가 준비됐습니다."
  info "레거시 대시보드: $(current_base_url)/"
  info "로그: $LOG_FILE"
}

stop_pid_gracefully() {
  local pid="$1"
  local label="$2"
  if ! is_pid_alive "$pid"; then
    return 0
  fi

  kill "$pid" >/dev/null 2>&1 || true
  local attempt=0
  while [ "$attempt" -lt 15 ]; do
    if ! is_pid_alive "$pid"; then
      info "$label 종료 완료 (pid=$pid)"
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done

  kill -9 "$pid" >/dev/null 2>&1 || true
  sleep 1
  if is_pid_alive "$pid"; then
    fail "$label 종료에 실패했습니다. pid=$pid"
  fi
  info "$label 강제 종료 완료 (pid=$pid)"
}

shutdown_server() {
  ensure_state_dir
  cleanup_stale_state

  local pid
  pid="$(read_pid_file || true)"
  if [ -z "$pid" ] && attach_to_existing_server_if_possible; then
    pid="$(read_pid_file || true)"
  fi

  if [ -z "$pid" ]; then
    info "종료할 서버 PID를 찾지 못했습니다."
    return 0
  fi

  stop_pid_gracefully "$pid" "미들웨어"
  rm -f "$PID_FILE"
  info "omnux 종료 완료"
}

detect_install_dir() {
  local candidate
  local path_entry
  IFS=':' read -r -a path_entries <<< "$PATH"

  local preferred=(
    "/opt/homebrew/bin"
    "$HOME/.npm-global/bin"
    "$HOME/.local/bin"
  )

  for candidate in "${preferred[@]}"; do
    if [ -d "$candidate" ] && [ -w "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  for path_entry in "${path_entries[@]}"; do
    if [ -n "$path_entry" ] && [ -d "$path_entry" ] && [ -w "$path_entry" ]; then
      printf '%s\n' "$path_entry"
      return 0
    fi
  done

  mkdir -p "$HOME/.local/bin"
  printf '%s\n' "$HOME/.local/bin"
}

install_cli_link() {
  local install_dir
  install_dir="$(detect_install_dir)"
  mkdir -p "$install_dir"
  ln -sf "$SCRIPT_PATH" "$install_dir/omnux"
  info "명령 등록 완료: $install_dir/omnux"
}

ensure_macos_build_tools() {
  if command_exists cc && command_exists make; then
    return 0
  fi

  if command_exists xcode-select; then
    xcode-select --install >/dev/null 2>&1 || true
  fi

  fail "macOS 빌드 도구가 없습니다. Xcode Command Line Tools 설치를 마친 뒤 다시 실행하세요."
}

brew_install_formula_if_missing() {
  local command_name="$1"
  local formula_name="$2"
  if command_exists "$command_name"; then
    return 0
  fi

  info "Homebrew로 $formula_name 설치 중"
  brew list --formula "$formula_name" >/dev/null 2>&1 || brew install "$formula_name"
}

brew_install_cask_if_missing() {
  local command_name="$1"
  local cask_name="$2"
  if command_exists "$command_name"; then
    return 0
  fi

  info "Homebrew로 $cask_name 설치 중"
  brew list --cask "$cask_name" >/dev/null 2>&1 || brew install --cask "$cask_name"
}

apt_install_packages_if_command_missing() {
  local command_name="$1"
  shift
  local packages=("$@")
  if command_exists "$command_name"; then
    return 0
  fi

  command_exists apt-get || fail "apt-get을 찾지 못했습니다. 필요한 도구를 직접 설치하세요: ${packages[*]}"
  info "apt-get으로 ${packages[*]} 설치 중"
  if [ "$(id -u)" -eq 0 ]; then
    apt-get update
    apt-get install -y "${packages[@]}"
    return 0
  fi

  command_exists sudo || fail "sudo가 없어 패키지 자동 설치를 할 수 없습니다: ${packages[*]}"
  sudo -n apt-get update
  sudo -n apt-get install -y "${packages[@]}"
}

run_setup() {
  case "$(uname -s)" in
    Darwin)
      command_exists brew || fail "Homebrew가 필요합니다. 먼저 Homebrew를 설치하세요."
      ensure_macos_build_tools

      brew_install_formula_if_missing node node
      brew_install_formula_if_missing npm node
      brew_install_formula_if_missing python3 python
      brew_install_formula_if_missing sqlite3 sqlite
      brew_install_cask_if_missing dotnet dotnet-sdk
      # 파이썬 추가 모듈
      info "파이썬 추가 모듈 설치 중"
      python3 -m pip install --quiet pygame matplotlib numpy requests beautifulsoup4 pillow flask fastapi uvicorn tkinter-inter 2>/dev/null || true
      ;;
    Linux)
      apt_install_packages_if_command_missing cc build-essential
      apt_install_packages_if_command_missing make build-essential
      apt_install_packages_if_command_missing node nodejs
      apt_install_packages_if_command_missing npm npm
      apt_install_packages_if_command_missing python3 python3 python3-pip
      apt_install_packages_if_command_missing sqlite3 sqlite3
      apt_install_packages_if_command_missing curl curl
      apt_install_packages_if_command_missing dotnet dotnet-sdk-9.0
      # 파이썬 GUI/게임/과학 모듈 (tkinter, pygame, matplotlib 등)
      info "파이썬 추가 모듈 설치 중"
      if command_exists sudo && [ "$(id -u)" -ne 0 ]; then
        sudo -n apt-get install -y python3-tk python3-pygame python3-matplotlib python3-numpy python3-requests python3-beautifulsoup4 python3-pillow 2>/dev/null || true
      elif [ "$(id -u)" -eq 0 ]; then
        apt-get install -y python3-tk python3-pygame python3-matplotlib python3-numpy python3-requests python3-beautifulsoup4 python3-pillow 2>/dev/null || true
      fi
      # pip 전용 모듈 (apt에 없는 것들)
      python3 -m pip install --quiet flask fastapi uvicorn 2>/dev/null || true
      ;;
    *)
      fail "현재 setup 자동 설치는 macOS(Homebrew)와 Linux(apt-get)만 지원합니다. Windows에서는 scripts/omnux.ps1을 사용하세요."
      ;;
  esac

  install_cli_link

  info "Node 의존성 설치"
  (cd "$REPO_ROOT" && npm ci)

  info ".NET 빌드"
  (cd "$REPO_ROOT" && dotnet build apps/omnux-middleware/Omnux.Middleware.csproj)

  info "샌드박스 smoke"
  (cd "$REPO_ROOT" && python3 apps/omnux-sandbox/executor.py --code "print('ok')")

  info "통합 테스트"
  (cd "$REPO_ROOT" && npm test)

  write_setup_marker
  info "setup 완료"
}

status_server() {
  local pid
  pid="$(read_pid_file)"
  if is_pid_alive "$pid"; then
    info "미들웨어 실행 중 (pid=${pid}, $(current_base_url))"
    if server_health_ok; then
      info "healthz: ok"
    else
      info "healthz: 응답 없음 (기동 중이거나 포트 점검 필요)"
    fi
  else
    info "미들웨어 미실행"
  fi
}

stop_middleware_on_port() {
  local port
  port="$(current_port)"
  if ! command_exists lsof; then
    return 0
  fi

  local pids
  pids="$(lsof -tiTCP:"$port" -sTCP:LISTEN -n -P 2>/dev/null || true)"
  if [ -z "$pids" ]; then
    return 0
  fi

  info "포트 ${port}에 기존 프로세스가 있습니다. 정리합니다."
  for pid in $pids; do
    kill "$pid" >/dev/null 2>&1 || true
  done
  sleep 1
  for pid in $pids; do
    if is_pid_alive "$pid"; then
      kill -9 "$pid" >/dev/null 2>&1 || true
    fi
  done
  sleep 0.5
}

run_desktop() {
  command_exists npm || fail "npm이 필요합니다. 먼저 'omnux setup'을 실행하세요."
  command_exists cargo || fail "Rust(cargo)가 필요합니다 (Tauri). https://rustup.rs 에서 설치 후 다시 시도하세요. 미들웨어만 실행하려면 'omnux start'를 사용하세요."
  local desktop_dir="${REPO_ROOT}/apps/desktop"
  [ -d "$desktop_dir" ] || fail "apps/desktop 디렉터리를 찾을 수 없습니다."
  if [ ! -d "${desktop_dir}/node_modules" ]; then
    info "데스크톱 의존성 설치 (apps/desktop)"
    (cd "$desktop_dir" && npm install)
  fi
  cleanup_stale_state
  if server_health_ok; then
    info "이미 실행 중인 미들웨어가 있으면 데스크톱 bootstrap이 재사용합니다. url=$(current_base_url)/"
  fi
  info "Tauri 데스크톱 dev 실행 — 자체 .NET 미들웨어(ws=41880)를 함께 띄웁니다."
  info "대시보드: http://localhost:1420/"
  info "인증이 필요하면 데스크톱 앱에서 OTP 요청 버튼을 누르세요. OTP가 이 터미널에 출력됩니다. (Ctrl+C 종료)"
  cd "$desktop_dir" || fail "apps/desktop 으로 이동하지 못했습니다."
  exec npm run tauri dev
}

main() {
  case "${1:-desktop}" in
    start)
      start_server
      ;;
    stop|shutdown)
      shutdown_server
      ;;
    status)
      status_server
      ;;
    desktop|"")
      run_desktop
      ;;
    setup)
      run_setup
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
