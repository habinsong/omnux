#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local source_path="$1"
  while [ -L "$source_path" ]; do
    local source_dir
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    local linked_path
    linked_path="$(readlink "$source_path")"
    if [[ "$linked_path" != /* ]]; then
      source_path="$source_dir/$linked_path"
    else
      source_path="$linked_path"
    fi
  done

  local final_dir
  final_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  printf '%s/%s\n' "$final_dir" "$(basename "$source_path")"
}

SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]:-$0}")"
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"

resolve_cli_state_dir() {
  printf '%s/cli\n' "${HOME}/.omnux"
}

STATE_DIR="$(resolve_cli_state_dir)"
PID_FILE="${STATE_DIR}/middleware.pid"
LOG_FILE="${STATE_DIR}/middleware.log"
META_FILE="${STATE_DIR}/last-start.env"
SETUP_MARKER_FILE="${STATE_DIR}/setup-complete"
MIDDLEWARE_PROJECT="${REPO_ROOT}/apps/omnux-middleware/Omnux.Middleware.csproj"
PACKAGE_LOCK="${REPO_ROOT}/package-lock.json"
DEFAULT_PORT="${OMNUX_WS_PORT:-41880}"
DEFAULT_BASE_URL="http://127.0.0.1:${DEFAULT_PORT}"

usage() {
  cat <<'EOF'
사용법:
  omnux           Tauri 데스크톱 앱 + 미들웨어 dev 실행 (포그라운드, Ctrl+C 종료)
  omnux desktop   위와 동일
  omnux start     미들웨어만 백그라운드 실행 (레거시 대시보드 http://127.0.0.1:41880/)
  omnux stop      omnux 전체 종료 (= shutdown)
  omnux shutdown  데스크톱 앱 + 미들웨어 등 모든 omnux 프로세스 종료
  omnux status    미들웨어 실행 상태 확인
  omnux setup     의존성 설치, 빌드, 검증, 명령 등록
EOF
}

info() {
  printf '[omnux] %s\n' "$1"
}

fail() {
  printf '[omnux] %s\n' "$1" >&2
  exit 1
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

current_port() {
  printf '%s\n' "${OMNUX_WS_PORT:-41880}"
}

current_base_url() {
  printf 'http://127.0.0.1:%s\n' "$(current_port)"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

ensure_command() {
  local command_name="$1"
  local message="$2"
  command_exists "$command_name" || fail "$message"
}

append_path_if_dir() {
  local dir="$1"
  [ -n "$dir" ] || return 0
  [ -d "$dir" ] || return 0
  case ":${PATH:-}:" in
    *":$dir:"*) ;;
    *) PATH="${PATH:+$PATH:}$dir" ;;
  esac
}

normalize_tool_path() {
  if [ -n "${HOME:-}" ]; then
    append_path_if_dir "$HOME/.cargo/bin"
    append_path_if_dir "$HOME/.local/bin"
    append_path_if_dir "$HOME/.npm-global/bin"
    append_path_if_dir "$HOME/.dotnet/tools"
  fi

  append_path_if_dir "/opt/homebrew/bin"
  append_path_if_dir "/opt/homebrew/sbin"
  append_path_if_dir "/usr/local/bin"
  append_path_if_dir "/usr/local/sbin"
  append_path_if_dir "/usr/local/share/dotnet"
  export PATH
}

normalize_tool_path

read_pid_file() {
  if [ -f "$PID_FILE" ]; then
    tr -d '[:space:]' < "$PID_FILE"
  fi
}

is_pid_alive() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" >/dev/null 2>&1
}

server_health_ok() {
  curl -fsS "$(current_base_url)/healthz" >/dev/null 2>&1
}

server_ready_ok() {
  curl -fsS "$(current_base_url)/readyz" >/dev/null 2>&1
}

normalize_runtime_env() {
  local port
  port="$(current_port)"
  export OMNUX_WS_PORT="${OMNUX_WS_PORT:-$port}"
  # CLI/desktop 보조 서버는 실제 봇 polling 소유권을 뺏지 않는다. 발송은 그대로 동작한다.
  export OMNUX_TELEGRAM_POLLING_DISABLED="${OMNUX_TELEGRAM_POLLING_DISABLED:-1}"
}

cleanup_stale_state() {
  local pid
  pid="$(read_pid_file || true)"
  if [ -n "$pid" ] && ! is_pid_alive "$pid"; then
    rm -f "$PID_FILE"
  fi
}

middleware_pids() {
  if ! command_exists pgrep; then
    return 0
  fi

  pgrep -f "$MIDDLEWARE_PROJECT" || true
}

attach_to_existing_server_if_possible() {
  if ! server_health_ok; then
    return 1
  fi

  local pids
  pids="$(middleware_pids)"
  if [ -z "$pids" ]; then
    return 1
  fi

  local adopted_pid
  adopted_pid="$(printf '%s\n' "$pids" | tail -n 1)"
  if [ -z "$adopted_pid" ]; then
    return 1
  fi

  ensure_state_dir
  printf '%s\n' "$adopted_pid" > "$PID_FILE"
  info "이미 실행 중인 서버를 재사용합니다. pid=${adopted_pid} url=$(current_base_url)/"
  return 0
}

ensure_runtime_commands() {
  local missing=()
  local required=(dotnet python3 node npm make cc curl)
  local tool
  for tool in "${required[@]}"; do
    if ! command_exists "$tool"; then
      missing+=("$tool")
    fi
  done

  if [ "${#missing[@]}" -gt 0 ]; then
    fail "필수 도구가 없습니다: ${missing[*]}. 먼저 'omnux setup'을 실행하세요."
  fi
}

has_node_modules() {
  [ -d "${REPO_ROOT}/node_modules" ]
}

is_setup_complete() {
  [ -f "$SETUP_MARKER_FILE" ] || return 1
  has_node_modules || return 1
  return 0
}

write_setup_marker() {
  ensure_state_dir
  cat > "$SETUP_MARKER_FILE" <<EOF
repo=$REPO_ROOT
script=$SCRIPT_PATH
completed_at=$(date '+%Y-%m-%d %H:%M:%S %z')
EOF
}

ensure_setup_if_needed() {
  if is_setup_complete; then
    return 0
  fi

  info "첫 실행이거나 setup 상태가 없어 자동 setup을 시작합니다."
  run_setup
}

port_in_use_by_other_process() {
  local port
  port="$(current_port)"
  if ! command_exists lsof; then
    return 1
  fi

  local lsof_output
  lsof_output="$(lsof -iTCP:"$port" -sTCP:LISTEN -n -P 2>/dev/null || true)"
  [ -n "$lsof_output" ]
}

wait_for_ready() {
  local pid="$1"
  local attempts="${OMNUX_CLI_READY_TIMEOUT_SEC:-180}"
  local step=0

  if ! [[ "$attempts" =~ ^[0-9]+$ ]] || [ "$attempts" -le 0 ]; then
    attempts=180
  fi

  while [ "$step" -lt "$attempts" ]; do
    if ! is_pid_alive "$pid"; then
      printf '\n' >&2
      tail -n 40 "$LOG_FILE" >&2 || true
      fail "서버 프로세스가 준비 전에 종료됐습니다. 로그를 확인하세요: $LOG_FILE"
    fi

    if server_health_ok && server_ready_ok; then
      return 0
    fi

    sleep 1
    step=$((step + 1))
  done

  printf '\n' >&2
  tail -n 40 "$LOG_FILE" >&2 || true
  fail "서버가 ${attempts}초 안에 $(current_base_url) 에서 준비 상태가 되지 않았습니다. 로그: $LOG_FILE"
}

write_start_metadata() {
  local pid="$1"
  cat > "$META_FILE" <<EOF
pid=$pid
port=$(current_port)
url=$(current_base_url)/
repo=$REPO_ROOT
log=$LOG_FILE
started_at=$(date '+%Y-%m-%d %H:%M:%S %z')
EOF
}

start_server() {
  ensure_state_dir
  cleanup_stale_state
  ensure_setup_if_needed
  ensure_runtime_commands
  normalize_runtime_env

  local current_pid
  current_pid="$(read_pid_file || true)"
  if is_pid_alive "$current_pid"; then
    if server_health_ok; then
      info "이미 실행 중입니다. pid=${current_pid} url=$(current_base_url)/"
      return 0
    fi
  fi

  if attach_to_existing_server_if_possible; then
    return 0
  fi

  if port_in_use_by_other_process; then
    fail "포트 $(current_port) 가 이미 사용 중입니다. 기존 서버를 정리한 뒤 다시 시도하세요."
  fi

  {
    printf '\n[%s] omnux start\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"
  } >> "$LOG_FILE"

  local pid
  pid="$(
    python3 - "$REPO_ROOT" "$MIDDLEWARE_PROJECT" "$LOG_FILE" <<'PY'
import os
import subprocess
import sys

repo_root, project_path, log_path = sys.argv[1:4]
env = os.environ.copy()
port = env.get("OMNUX_WS_PORT") or "41880"
env.setdefault("OMNUX_WS_PORT", port)
env.setdefault("OMNUX_TELEGRAM_POLLING_DISABLED", "1")
workspace_root = env.get("OMNUX_WORKSPACE_ROOT") or os.path.join(repo_root, "workspace", "coding")
env.setdefault("OMNUX_WORKSPACE_ROOT", workspace_root)
local_otp = env.get("OMNUX_ENABLE_LOCAL_OTP_FALLBACK") or "1"
env.setdefault("OMNUX_ENABLE_LOCAL_OTP_FALLBACK", local_otp)
startup_probe = env.get("OMNUX_GATEWAY_STARTUP_PROBE") or "1"
env.setdefault("OMNUX_GATEWAY_STARTUP_PROBE", startup_probe)

with open(log_path, "ab", buffering=0) as log_file:
    process = subprocess.Popen(
        ["dotnet", "run", "--project", project_path],
        cwd=repo_root,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=log_file,
        stderr=log_file,
        start_new_session=True
    )

print(process.pid)
PY
  )"
  printf '%s\n' "$pid" > "$PID_FILE"
  write_start_metadata "$pid"

  info "서버 시작 중입니다. pid=${pid}"
  wait_for_ready "$pid"

  info "서버가 준비됐습니다."
  info "레거시 대시보드: $(current_base_url)/"
  info "로그: $LOG_FILE"
}

stop_pid_gracefully() {
  local pid="$1"
  local label="$2"
  if ! is_pid_alive "$pid"; then
    return 0
  fi

  kill "$pid" >/dev/null 2>&1 || true
  local attempt=0
  while [ "$attempt" -lt 15 ]; do
    if ! is_pid_alive "$pid"; then
      info "$label 종료 완료 (pid=$pid)"
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done

  kill -9 "$pid" >/dev/null 2>&1 || true
  sleep 1
  if is_pid_alive "$pid"; then
    fail "$label 종료에 실패했습니다. pid=$pid"
  fi
  info "$label 강제 종료 완료 (pid=$pid)"
}

# cmdline 패턴으로 묶이는 프로세스를 graceful(SIGTERM) → 강제(SIGKILL)로 정리.
# 자기 자신($$)과 부모 셸은 제외해 shutdown 도중 자살하지 않게 한다.
kill_processes_by_pattern() {
  local pattern="$1"
  local label="$2"
  command_exists pgrep || return 0

  local pids
  pids="$(pgrep -f "$pattern" 2>/dev/null | grep -vE "^($$|${PPID:-0})$" || true)"
  if [ -z "$pids" ]; then
    return 0
  fi

  info "$label 종료 중 (pid:$(printf ' %s' $pids))"
  local p
  for p in $pids; do
    kill "$p" >/dev/null 2>&1 || true
  done

  local attempt=0
  while [ "$attempt" -lt 8 ]; do
    local alive=""
    for p in $pids; do
      is_pid_alive "$p" && alive="$alive $p"
    done
    if [ -z "$alive" ]; then
      info "$label 종료 완료"
      return 0
    fi
    sleep 1
    attempt=$((attempt + 1))
  done

  for p in $pids; do
    is_pid_alive "$p" && kill -9 "$p" >/dev/null 2>&1 || true
  done
  info "$label 강제 종료 완료"
}

# 전용 포트의 LISTEN 프로세스를 정리.
stop_listeners_on_port() {
  local port="$1"
  local label="$2"
  command_exists lsof || return 0

  local pids
  pids="$(lsof -tiTCP:"$port" -sTCP:LISTEN -n -P 2>/dev/null | grep -vE "^($$|${PPID:-0})$" || true)"
  if [ -z "$pids" ]; then
    return 0
  fi

  info "$label(포트 $port) 정리 중 (pid:$(printf ' %s' $pids))"
  local p
  for p in $pids; do
    kill "$p" >/dev/null 2>&1 || true
  done
  sleep 1
  for p in $pids; do
    is_pid_alive "$p" && kill -9 "$p" >/dev/null 2>&1 || true
  done
}

# 미들웨어뿐 아니라 데스크톱 앱·tauri dev·vite 까지 omnux 관련 프로세스를 모두 종료한다.
shutdown_server() {
  ensure_state_dir
  cleanup_stale_state

  info "omnux 전체 종료를 시작합니다 (데스크톱 + 미들웨어)."

  # 1) CLI(omnux start)가 추적하던 백그라운드 미들웨어 PID
  local pid
  pid="$(read_pid_file || true)"
  if [ -z "$pid" ] && attach_to_existing_server_if_possible; then
    pid="$(read_pid_file || true)"
  fi
  if [ -n "$pid" ]; then
    stop_pid_gracefully "$pid" "미들웨어(CLI)"
  fi
  rm -f "$PID_FILE"

  # 2) 데스크톱(Tauri) 앱 + tauri dev + vite — 먼저 내려야 미들웨어를 재spawn 하지 않는다.
  kill_processes_by_pattern "omnux_desktop" "데스크톱 앱"
  kill_processes_by_pattern "tauri dev" "tauri dev"
  kill_processes_by_pattern "${REPO_ROOT}/apps/desktop" "데스크톱 dev(vite/npm)"

  # 3) 미들웨어 — 데스크톱이 spawn 한 것 포함 (이름 기반: dotnet run + 빌드 바이너리 모두 매칭)
  kill_processes_by_pattern "Omnux.Middleware" "미들웨어"

  # 4) 전용 포트에 남은 프로세스 정리 (미들웨어 41880 + 데스크톱 dev 1420)
  stop_listeners_on_port "$(current_port)" "미들웨어"
  stop_listeners_on_port "1420" "데스크톱 dev"

  info "omnux 종료 완료"
}

detect_install_dir() {
  local candidate
  local path_entry
  IFS=':' read -r -a path_entries <<< "$PATH"

  local preferred=(
    "$HOME/.local/bin"
    "$HOME/.npm-global/bin"
    "$HOME/bin"
    "/opt/homebrew/bin"
    "/usr/local/bin"
  )

  for candidate in "${preferred[@]}"; do
    if [ -d "$candidate" ] && [ -w "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  for path_entry in "${path_entries[@]}"; do
    if [ -n "$path_entry" ] && [ -d "$path_entry" ] && [ -w "$path_entry" ]; then
      printf '%s\n' "$path_entry"
      return 0
    fi
  done

  mkdir -p "$HOME/.local/bin"
  printf '%s\n' "$HOME/.local/bin"
}

install_cli_link() {
  local install_dir
  install_dir="$(detect_install_dir)"
  mkdir -p "$install_dir"
  ln -sf "$SCRIPT_PATH" "$install_dir/omnux"
  info "명령 등록 완료: $install_dir/omnux"
}

ensure_macos_build_tools() {
  if command_exists cc && command_exists make; then
    return 0
  fi

  if command_exists xcode-select; then
    xcode-select --install >/dev/null 2>&1 || true
  fi

  fail "macOS 빌드 도구가 없습니다. Xcode Command Line Tools 설치를 마친 뒤 다시 실행하세요."
}

brew_install_formula_if_missing() {
  local command_name="$1"
  local formula_name="$2"
  if command_exists "$command_name"; then
    return 0
  fi

  info "Homebrew로 $formula_name 설치 중"
  brew list --formula "$formula_name" >/dev/null 2>&1 || brew install "$formula_name"
}

brew_install_cask_if_missing() {
  local command_name="$1"
  local cask_name="$2"
  if command_exists "$command_name"; then
    return 0
  fi

  info "Homebrew로 $cask_name 설치 중"
  brew list --cask "$cask_name" >/dev/null 2>&1 || brew install --cask "$cask_name"
}

run_with_privilege() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
    return $?
  fi

  command_exists sudo || fail "sudo가 없어 패키지 자동 설치를 할 수 없습니다: $*"
  sudo -v || fail "sudo 권한을 얻지 못했습니다."
  sudo "$@"
}

linux_package_manager() {
  local manager
  for manager in apt-get dnf yum pacman zypper apk; do
    if command_exists "$manager"; then
      printf '%s\n' "$manager"
      return 0
    fi
  done
  return 1
}

linux_packages_for_command() {
  local command_name="$1"
  local manager="$2"
  case "$manager:$command_name" in
    apt-get:cc|apt-get:make) printf '%s\n' build-essential ;;
    dnf:cc|dnf:make|yum:cc|yum:make) printf '%s\n' gcc gcc-c++ make ;;
    pacman:cc|pacman:make) printf '%s\n' base-devel ;;
    zypper:cc|zypper:make) printf '%s\n' gcc gcc-c++ make ;;
    apk:cc|apk:make) printf '%s\n' build-base ;;

    apt-get:node) printf '%s\n' nodejs ;;
    dnf:node|yum:node|pacman:node|zypper:node|apk:node) printf '%s\n' nodejs ;;

    apt-get:npm|dnf:npm|yum:npm|pacman:npm|zypper:npm|apk:npm) printf '%s\n' npm ;;

    apt-get:python3|dnf:python3|yum:python3|zypper:python3) printf '%s\n' python3 python3-pip ;;
    pacman:python3) printf '%s\n' python python-pip ;;
    apk:python3) printf '%s\n' python3 py3-pip ;;

    apt-get:sqlite3|zypper:sqlite3) printf '%s\n' sqlite3 ;;
    dnf:sqlite3|yum:sqlite3|pacman:sqlite3|apk:sqlite3) printf '%s\n' sqlite ;;

    apt-get:curl|dnf:curl|yum:curl|pacman:curl|zypper:curl|apk:curl) printf '%s\n' curl ;;
    apt-get:pkg-config) printf '%s\n' pkg-config ;;
    dnf:pkg-config|yum:pkg-config|zypper:pkg-config) printf '%s\n' pkgconf-pkg-config ;;
    pacman:pkg-config|apk:pkg-config) printf '%s\n' pkgconf ;;

    apt-get:dotnet|dnf:dotnet|yum:dotnet|zypper:dotnet) printf '%s\n' dotnet-sdk-9.0 ;;
    pacman:dotnet) printf '%s\n' dotnet-sdk ;;
    apk:dotnet) printf '%s\n' dotnet9-sdk ;;
    *) return 1 ;;
  esac
}

install_linux_packages() {
  local manager="$1"
  shift
  local packages=("$@")
  [ "${#packages[@]}" -gt 0 ] || return 0

  info "${manager}로 ${packages[*]} 설치 중"
  case "$manager" in
    apt-get)
      run_with_privilege apt-get update || true
      if ! run_with_privilege apt-get install -y "${packages[@]}"; then
        info "패키지 설치 실패: 의존성 문제(--fix-broken) 자동 복구를 시도합니다..."
        run_with_privilege apt-get --fix-broken install -y
        info "복구 완료 후 재설치를 시도합니다..."
        run_with_privilege apt-get install -y "${packages[@]}"
      fi
      ;;
    dnf)
      run_with_privilege dnf install -y "${packages[@]}"
      ;;
    yum)
      run_with_privilege yum install -y "${packages[@]}"
      ;;
    pacman)
      run_with_privilege pacman -Sy --needed --noconfirm "${packages[@]}"
      ;;
    zypper)
      run_with_privilege zypper --non-interactive install "${packages[@]}"
      ;;
    apk)
      run_with_privilege apk add --no-cache "${packages[@]}"
      ;;
    *)
      fail "지원하지 않는 Linux 패키지 매니저입니다: $manager"
      ;;
  esac
}

install_linux_packages_if_command_missing() {
  local command_name="$1"
  if command_exists "$command_name"; then
    return 0
  fi

  local manager
  manager="$(linux_package_manager)" || fail "지원되는 Linux 패키지 매니저를 찾지 못했습니다. 필요한 도구를 직접 설치하세요: $command_name"

  local packages=()
  while IFS= read -r package_name; do
    [ -n "$package_name" ] && packages+=("$package_name")
  done < <(linux_packages_for_command "$command_name" "$manager")

  if [ "${#packages[@]}" -eq 0 ]; then
    fail "${manager}에서 $command_name 설치 패키지를 결정하지 못했습니다. 직접 설치 후 다시 실행하세요."
  fi

  install_linux_packages "$manager" "${packages[@]}"
  command_exists "$command_name" || fail "$command_name 설치 후에도 PATH에서 찾지 못했습니다. 터미널을 다시 열거나 PATH를 확인하세요."
}

linux_tauri_pkg_config_ok() {
  command_exists pkg-config || return 1

  local module
  for module in glib-2.0 gobject-2.0 gtk+-3.0 webkit2gtk-4.1; do
    pkg-config --exists "$module" || return 1
  done
}

linux_tauri_packages() {
  local manager="$1"
  case "$manager" in
    apt-get)
      printf '%s\n' \
        pkg-config \
        libglib2.0-dev \
        libgtk-3-dev \
        libwebkit2gtk-4.1-dev \
        libxdo-dev \
        libssl-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        wget \
        file
      ;;
    dnf|yum)
      printf '%s\n' \
        pkgconf-pkg-config \
        glib2-devel \
        gtk3-devel \
        webkit2gtk4.1-devel \
        openssl-devel \
        libappindicator-gtk3-devel \
        librsvg2-devel \
        libxdo-devel \
        wget \
        file
      ;;
    pacman)
      printf '%s\n' \
        pkgconf \
        glib2 \
        gtk3 \
        webkit2gtk-4.1 \
        openssl \
        appmenu-gtk-module \
        libappindicator-gtk3 \
        librsvg \
        xdotool \
        wget \
        file
      ;;
    zypper)
      printf '%s\n' \
        pkgconf-pkg-config \
        glib2-devel \
        gtk3-devel \
        webkit2gtk3-devel \
        libopenssl-devel \
        libappindicator3-1 \
        librsvg-devel \
        wget \
        file
      ;;
    apk)
      printf '%s\n' \
        pkgconf \
        glib-dev \
        gtk+3.0-dev \
        webkit2gtk-4.1-dev \
        openssl-dev \
        libayatana-appindicator-dev \
        librsvg-dev \
        xdotool \
        wget \
        file
      ;;
    *)
      return 1
      ;;
  esac
}

install_linux_tauri_dependencies() {
  if linux_tauri_pkg_config_ok; then
    return 0
  fi

  local manager
  manager="$(linux_package_manager)" || fail "지원되는 Linux 패키지 매니저를 찾지 못했습니다. Tauri 시스템 의존성을 직접 설치하세요."

  local packages=()
  while IFS= read -r package_name; do
    [ -n "$package_name" ] && packages+=("$package_name")
  done < <(linux_tauri_packages "$manager")

  if [ "${#packages[@]}" -eq 0 ]; then
    fail "${manager}에서 Tauri 시스템 의존성 패키지를 결정하지 못했습니다. 직접 설치 후 다시 실행하세요."
  fi

  install_linux_packages "$manager" "${packages[@]}"

  if ! linux_tauri_pkg_config_ok; then
    fail "Tauri Linux 시스템 의존성 설치 후에도 pkg-config가 glib-2.0/gobject-2.0/gtk+-3.0/webkit2gtk-4.1 모듈을 찾지 못했습니다. 배포판 패키지 저장소와 PKG_CONFIG_PATH를 확인하세요."
  fi
}

install_optional_linux_python_modules() {
  local manager
  manager="$(linux_package_manager)" || return 0

  local packages=()
  case "$manager" in
    apt-get) packages=(python3-tk python3-pygame python3-matplotlib python3-numpy python3-requests python3-bs4 python3-pil) ;;
    dnf|yum) packages=(python3-tkinter python3-pygame python3-matplotlib python3-numpy python3-requests python3-beautifulsoup4 python3-pillow) ;;
    pacman) packages=(tk python-pygame python-matplotlib python-numpy python-requests python-beautifulsoup4 python-pillow) ;;
    zypper) packages=(python3-tk python3-pygame python3-matplotlib python3-numpy python3-requests python3-beautifulsoup4 python3-Pillow) ;;
    apk) packages=(py3-tkinter py3-pygame py3-matplotlib py3-numpy py3-requests py3-beautifulsoup4 py3-pillow) ;;
  esac

  if [ "${#packages[@]}" -gt 0 ]; then
    install_linux_packages "$manager" "${packages[@]}" 2>/dev/null || true
  fi
}

run_setup() {
  case "$(uname -s)" in
    Darwin)
      command_exists brew || fail "Homebrew가 필요합니다. 먼저 Homebrew를 설치하세요."
      ensure_macos_build_tools

      brew_install_formula_if_missing node node
      brew_install_formula_if_missing npm node
      brew_install_formula_if_missing python3 python
      brew_install_formula_if_missing sqlite3 sqlite
      brew_install_cask_if_missing dotnet dotnet-sdk
      # 파이썬 추가 모듈
      info "파이썬 추가 모듈 설치 중"
      python3 -m pip install --quiet pygame matplotlib numpy requests beautifulsoup4 pillow flask fastapi uvicorn tkinter-inter 2>/dev/null || true
      ;;
    Linux)
      install_linux_packages_if_command_missing cc
      install_linux_packages_if_command_missing make
      install_linux_packages_if_command_missing node
      install_linux_packages_if_command_missing npm
      install_linux_packages_if_command_missing python3
      install_linux_packages_if_command_missing sqlite3
      install_linux_packages_if_command_missing curl
      install_linux_packages_if_command_missing dotnet
      install_linux_tauri_dependencies
      # 파이썬 GUI/게임/과학 모듈 (tkinter, pygame, matplotlib 등)
      info "파이썬 추가 모듈 설치 중"
      install_optional_linux_python_modules
      # pip 전용 모듈 (apt에 없는 것들)
      python3 -m pip install --quiet flask fastapi uvicorn 2>/dev/null || true
      ;;
    *)
      fail "현재 setup 자동 설치는 macOS(Homebrew)와 Linux 패키지 매니저만 지원합니다. Windows에서는 scripts/omnux.ps1을 사용하세요."
      ;;
  esac

  install_cli_link

  info "Node 의존성 설치"
  (cd "$REPO_ROOT" && npm ci)

  info ".NET 빌드"
  (cd "$REPO_ROOT" && dotnet build apps/omnux-middleware/Omnux.Middleware.csproj)

  info "샌드박스 smoke"
  (cd "$REPO_ROOT" && python3 apps/omnux-sandbox/executor.py --code "print('ok')")

  info "통합 테스트"
  (cd "$REPO_ROOT" && npm test)

  write_setup_marker
  info "setup 완료"
}

status_server() {
  local pid
  pid="$(read_pid_file)"
  if is_pid_alive "$pid"; then
    info "미들웨어 실행 중 (pid=${pid}, $(current_base_url))"
    if server_health_ok; then
      info "healthz: ok"
    else
      info "healthz: 응답 없음 (기동 중이거나 포트 점검 필요)"
    fi
  else
    info "미들웨어 미실행"
  fi
}

stop_middleware_on_port() {
  local port
  port="$(current_port)"
  if ! command_exists lsof; then
    return 0
  fi

  local pids
  pids="$(lsof -tiTCP:"$port" -sTCP:LISTEN -n -P 2>/dev/null || true)"
  if [ -z "$pids" ]; then
    return 0
  fi

  info "포트 ${port}에 기존 프로세스가 있습니다. 정리합니다."
  for pid in $pids; do
    kill "$pid" >/dev/null 2>&1 || true
  done
  sleep 1
  for pid in $pids; do
    if is_pid_alive "$pid"; then
      kill -9 "$pid" >/dev/null 2>&1 || true
    fi
  done
  sleep 0.5
}

ensure_desktop_system_dependencies() {
  case "$(uname -s)" in
    Linux)
      install_linux_tauri_dependencies
      ;;
  esac
}

run_desktop() {
  ensure_command npm "npm이 필요합니다. 먼저 'omnux setup'을 실행하세요."
  ensure_command cargo "Rust(cargo)가 필요합니다 (Tauri). https://rustup.rs 에서 설치 후 다시 시도하세요. 미들웨어만 실행하려면 'omnux start'를 사용하세요."
  ensure_desktop_system_dependencies
  local desktop_dir="${REPO_ROOT}/apps/desktop"
  [ -d "$desktop_dir" ] || fail "apps/desktop 디렉터리를 찾을 수 없습니다."
  if [ ! -d "${desktop_dir}/node_modules" ]; then
    info "데스크톱 의존성 설치 (apps/desktop)"
    (cd "$desktop_dir" && npm install)
  fi
  cleanup_stale_state
  if server_health_ok; then
    info "이미 실행 중인 미들웨어가 있으면 데스크톱 bootstrap이 재사용합니다. url=$(current_base_url)/"
  fi
  info "Tauri 데스크톱 dev 실행 — 자체 .NET 미들웨어(ws=41880)를 함께 띄웁니다."
  info "대시보드: http://localhost:1420/"
  info "인증이 필요하면 데스크톱 앱에서 OTP 요청 버튼을 누르세요. OTP가 이 터미널에 출력됩니다. (Ctrl+C 종료)"
  cd "$desktop_dir" || fail "apps/desktop 으로 이동하지 못했습니다."
  exec npm run tauri dev
}

main() {
  case "${1:-desktop}" in
    start)
      start_server
      ;;
    stop|shutdown)
      shutdown_server
      ;;
    status)
      status_server
      ;;
    desktop|"")
      run_desktop
      ;;
    setup)
      run_setup
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
